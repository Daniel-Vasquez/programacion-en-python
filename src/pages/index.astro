---
import { getCollection } from "astro:content";
import courses from "../content/courses.json";
import CourseLayout from "../layouts/CourseLayout.astro";

const allSections = await getCollection("sections");
const course = courses[0];

const courseSections = allSections
  .filter((s) => s.data.course === course.id)
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => {
    const [, secSlug] = s.id.split("/");
    return {
      slug: secSlug,
      sectionId: s.data.sectionId,
      title: s.data.title,
      order: s.data.order,
      minutes: s.data.minutes,
      summary: s.data.summary,
    };
  });
---

<CourseLayout
  title={course.title}
  description={course.description}
  courseId={course.id}
  courseSlug={course.slug}
  courseTitle={course.title}
  plannedSections={course.plannedSections}
  sections={courseSections}
>
  <section class="mx-auto max-w-[68ch]">
    <p class="font-sans text-sm font-semibold tracking-wider text-accent-strong uppercase">
      Curso {course.id} · {courseSections.length} de {course.plannedSections} secciones publicadas
    </p>
    <h1 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      {course.title}
    </h1>
    <p class="mt-4 font-serif text-lg leading-relaxed text-muted">
      {course.description}
    </p>

    <div class="mt-10 space-y-4">
      {
        courseSections.map((sec) => (
          <a
            href={`/cursos/${course.slug}/${sec.slug}`}
            class="group block rounded-xl border border-surface-2 bg-surface p-6 transition hover:border-accent"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-xs font-semibold text-accent-strong">
                {sec.sectionId} · Sección {sec.order} de {course.plannedSections}
              </span>
              <span class="font-sans text-xs text-muted">{sec.minutes} min</span>
            </div>
            <h2 class="mt-2 font-serif text-2xl font-semibold text-fg group-hover:text-accent-strong">
              {sec.title}
            </h2>
            <p class="mt-2 font-serif text-base leading-relaxed text-muted">
              {sec.summary}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</CourseLayout>
