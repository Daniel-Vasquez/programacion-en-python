---
import { getCollection, render } from "astro:content";
import courses from "../../../content/courses.json";
import CourseLayout from "../../../layouts/CourseLayout.astro";
import Callout from "../../../components/Callout.astro";
import MarkAsReadButton from "../../../components/MarkAsReadButton";
import SectionNav from "../../../components/SectionNav.astro";

export async function getStaticPaths() {
  const allSections = await getCollection("sections");

  return allSections.map((entry) => {
    const [courseSlug, fileSlug] = entry.id.split("/");
    const courseMeta =
      courses.find((c) => c.slug === courseSlug || c.id === entry.data.course) ?? {
        id: entry.data.course,
        slug: courseSlug,
        title: "Curso de Python",
        plannedSections: 7,
      };

    const courseSections = allSections
      .filter((s) => s.data.course === entry.data.course)
      .sort((a, b) => a.data.order - b.data.order)
      .map((s) => {
        const [, secSlug] = s.id.split("/");
        return {
          slug: secSlug,
          sectionId: s.data.sectionId,
          title: s.data.title,
          order: s.data.order,
          minutes: s.data.minutes,
        };
      });

    const currentIndex = courseSections.findIndex((s) => s.slug === fileSlug);
    const prev = currentIndex > 0 ? courseSections[currentIndex - 1] : null;
    const next =
      currentIndex >= 0 && currentIndex < courseSections.length - 1
        ? courseSections[currentIndex + 1]
        : null;

    return {
      params: {
        course: courseSlug,
        section: fileSlug,
      },
      props: {
        entry,
        courseMeta,
        courseSections,
        fileSlug,
        prev,
        next,
      },
    };
  });
}

const { entry, courseMeta, courseSections, fileSlug, prev, next } = Astro.props;
const { Content } = await render(entry);
const { sectionId, title, summary, order, minutes } = entry.data;
---

<CourseLayout
  title={title}
  description={summary}
  courseId={courseMeta.id}
  courseSlug={courseMeta.slug}
  courseTitle={courseMeta.title}
  plannedSections={courseMeta.plannedSections}
  sections={courseSections}
  currentSlug={fileSlug}
>
  <article class="mx-auto max-w-[68ch]">
    <header class="mb-10">
      <p class="text-sm text-muted">
        {sectionId} · Sección {order} de {courseMeta.plannedSections} · {minutes} min
      </p>
      <h1 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        {title}
      </h1>
      <p class="mt-4 font-serif text-lg leading-relaxed text-muted">{summary}</p>
    </header>

    <div
      class="prose prose-lg max-w-none font-serif prose-headings:font-semibold prose-headings:tracking-tight prose-h2:mt-14 prose-pre:my-6"
    >
      <Content components={{ Callout }} />
    </div>

    <footer class="mt-16 border-t border-surface-2 pt-8">
      <MarkAsReadButton client:load sectionId={sectionId} sectionTitle={title} />
      <SectionNav courseSlug={courseMeta.slug} prev={prev} next={next} />
    </footer>
  </article>
</CourseLayout>
