---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle";

interface SectionItem {
  slug: string;
  sectionId: string;
  title: string;
  order: number;
  minutes: number;
}

interface Props {
  title: string;
  description?: string;
  courseId: string;
  courseSlug: string;
  courseTitle: string;
  plannedSections: number;
  sections: SectionItem[];
  currentSlug?: string;
}

const {
  title,
  description,
  courseId,
  courseSlug,
  courseTitle,
  plannedSections,
  sections,
  currentSlug,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Dani Academy</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("dani-academy-theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = saved || (prefersDark ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-bg text-fg antialiased">
    <header class="sticky top-0 z-20 border-b border-surface-2 bg-bg/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6">
        <div class="flex items-center gap-3">
          <a
            href="/"
            class="font-serif text-lg font-semibold tracking-tight text-fg hover:text-accent-strong"
          >
            Dani Academy
          </a>
          <span class="text-muted">/</span>
          <span class="font-sans text-xs font-semibold tracking-wider text-accent-strong uppercase">
            {courseId} · {courseTitle}
          </span>
        </div>
        <ThemeToggle client:load />
      </div>
    </header>

    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[260px_1fr]">
      <aside class="lg:sticky lg:top-20 lg:self-start">
        <div class="rounded-xl border border-surface-2 bg-surface p-4">
          <p class="font-sans text-xs font-semibold tracking-wider text-muted uppercase">
            Índice del curso ({sections.length} de {plannedSections})
          </p>
          <ul class="mt-3 space-y-1.5">
            {
              sections.map((sec) => {
                const isActive = sec.slug === currentSlug;
                return (
                  <li>
                    <a
                      href={`/cursos/${courseSlug}/${sec.slug}`}
                      class:list={[
                        "block rounded-lg px-3 py-2 font-sans text-sm transition",
                        isActive
                          ? "bg-accent/15 font-semibold text-accent-strong"
                          : "text-fg hover:bg-surface-2",
                      ]}
                    >
                      <span class="font-mono text-xs text-muted">{sec.sectionId}</span>
                      <span class="ml-1.5">{sec.title}</span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </aside>

      <main class="min-w-0">
        <slot />
      </main>
    </div>
  </body>
</html>
